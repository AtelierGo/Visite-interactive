{
  "name": "atelier-3d",
  "version": "0.7.0",
  "description": "Du plan Illustrator à l’échelle à la visite 3D (GLB).",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "exemple": "electron . --projet=exemples/rue-des-balances",
    "dist:mac": "electron-builder --mac",
    "dist:win": "electron-builder --win"
  },
  "license": "UNLICENSED",
  "devDependencies": {
    "electron": "33.2.1",
    "electron-builder": "25.1.8"
  },
  "productName": "Atelier 3D",
  "private": true,
  "build": {
    "appId": "fr.atelier3d.app",
    "productName": "Atelier 3D",
    "files": [
      "main.js",
      "preload.js",
      "accueil.html",
      "editeur/template.html",
      "moteur/**/*",
      "!moteur/**/__pycache__",
      "exemples/**/*",
      "vendor/**/*",
      "visite/template.html"
    ],
    "asarUnpack": [
      "moteur/**/*"
    ],
    "mac": {
      "category": "public.app-category.graphics-design",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "identity": "-",
      "hardenedRuntime": false,
      "gatekeeperAssess": false
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
